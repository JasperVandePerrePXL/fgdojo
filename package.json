{
  "name": "fgdojoleaderboard",
  "version": "1.0.0",
  "description": "Fighting Game Dojo leaderboard website",
  "license": "ISC",
  "author": "IzLeStick",
  "type": "module",
  "scripts": {
    "start": "vite preview --port 3000",
    "dev": "vite",
    "refresh": "node src/cli/refresh.js",
    "fetch": "node src/pipeline/fetch_tournaments.js",
    "process": "node src/pipeline/process_leaderboard.js",
    "next-event": "node src/next_event/cli.js",
    "seeding": "npm run fetch && node src/cli/seeding.js",
    "build": "npm run fetch && npm run process && vite build",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.5",
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  }
}
